# PiratecultJAV Environment Configuration
# Required production variables per Project Guide Section 5

# Telegram Bot Token from @BotFather (primary)
BOT_TOKEN=

# Optional recovery bot token. Add this bot to the same dump/force-sub channels.
BACKUP_BOT_TOKEN=

# Which bot to prefer on startup: primary or backup. If primary fails, backup is selected automatically.
ACTIVE_BOT=primary

# Supabase credentials (server-side secret key; never expose to client)
# Direct PostgreSQL connection used to automatically apply supabase/migrations on startup.
# Use the Supabase Session Pooler if your host cannot reach the direct database endpoint.
DATABASE_URL=
# Keep true for Supabase. Set false only for a local PostgreSQL instance without TLS.
DATABASE_SSL=true
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Telegram Dump Channel ID (actual media storage layer)
DUMP_CHAT_ID=-1004426377644

# Private Telegram channel where each screenshot post is captioned with its video code (e.g. HMN-818).
# Add the bot to this channel and set this to its numeric chat ID, such as -1001234567890.
SCREENSHOT_CHANNEL_ID=

# Comma-separated Telegram User IDs with admin access
ADMIN_IDS=

# Javtiful Metadata Provider Base URL
JAVTIFUL_BASE_URL=https://javtiful.com

# Server Port (Render provides PORT automatically)
PORT=3000

# Number of trusted reverse-proxy hops. Render normally uses one.
# Leave unset for local development.
# TRUST_PROXY_HOPS=1

# Telegram long polling is the default and recommended mode for the single Render service.
# WEBHOOK_* values are not required and are ignored by the default startup path.
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_PATH=/telegram-webhook

# Optional Pyrogram historical indexer (runs inside this same Render service).
# The worker starts automatically when all four required values are present.
# Set HISTORICAL_INDEXER_ENABLED=false to disable it.
HISTORICAL_INDEXER_ENABLED=false
API_ID=
API_HASH=
SESSION_ENCRYPTION_KEY=
PYTHON_BIN=python3
POLL_INTERVAL_SECONDS=5
BATCH_SIZE=50

# Required for dashboard/admin API authentication
# Generate a unique random value with at least 32 characters.
ADMIN_API_KEY=

# Indexer worker tuning (safe defaults: 2 concurrent jobs, 3-minute renewable leases)
INDEXER_CONCURRENCY=2
INDEXER_POLL_INTERVAL_MS=4000
INDEXER_PROVIDER_DELAY_MS=2000
INDEXER_MAX_ATTEMPTS=3
INDEXER_LEASE_SECONDS=180

# Runtime resilience
# Primary polling failures can switch to BACKUP_BOT_TOKEN once per process.
# Webhook mode also checks Telegram token health every 60 seconds; two consecutive
# failures trigger the same one-time primary-to-backup switch.

# Telegram Stars Premium pricing (amounts are Stars)
PREMIUM_7_STARS=50
PREMIUM_30_STARS=150
PREMIUM_90_STARS=350
